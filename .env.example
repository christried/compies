# Neon connection string of your own dev branch (pooled or direct). Used by the app and drizzle-kit.
DATABASE_URL=postgresql://user:password@ep-example-123456.eu-central-1.aws.neon.tech/neondb?sslmode=require

# Better Auth: the origin this app runs on, and a random secret of at least 32 characters.
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=

# OAuth apps (redirect URIs: <origin>/api/auth/callback/discord and .../twitch).
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# Host permission and Platform admin, as provider account ids (ADR 0002): discord:<id>,twitch:<id>
HOST_PROVIDER_IDS=
ADMIN_PROVIDER_IDS=

# Cloudflare R2 for game images (#139). Set in Vercel by scripts/wizards/r2-setup.sh.
# Leave empty locally unless you test image upload against a real bucket.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Optional: eu when the buckets use the EU jurisdiction (endpoint <account>.eu.r2.cloudflarestorage.com).
R2_JURISDICTION=

# Simulates the staging build locally: name, tinted icons and the STAGING badge (#178). Vercel sets the
# branch itself on staging, so leave this commented out unless you want to see the staging look.
# COMPIES_STAGE=staging
